# =============================================================================
# Smart Campus Analytics - backend environment (copy to backend/.env)
# =============================================================================
# Copy this file to `backend/.env` and fill in real values. `backend/.env` is
# git-ignored and is NEVER sent to the frontend. Never commit real keys.

# --- OpenRouter (assistant answer generation) --------------------------------
# Leave OPENROUTER_API_KEY blank to run in retrieval-only / deterministic mode.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
# Any chat model id published on https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers recommended by OpenRouter (safe to leave blank).
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Smart Campus Analytics

# --- Generation tuning -------------------------------------------------------
RAG_LLM_TIMEOUT=60
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=768
RAG_LLM_MAX_RETRIES=3
RAG_LLM_RETRY_BACKOFF=1.5
RAG_MAX_CONTEXT_CHARS=4000
# Force deterministic mode (no external calls) by uncommenting:
# RAG_DISABLE_LLM=1

# --- Retrieval / index (all optional; retrieval is always local) -------------
# Embeddings use a deterministic offline hashing vectorizer (no model server).
# RAG_TOP_K=6
# RAG_HYBRID_ALPHA=0.55
# RAG_HASH_DIM=4096
# RAG_CHUNK_SIZE=1400
# RAG_CHUNK_OVERLAP=160
# RAG_MAX_CONTEXT_CHARS=4000
